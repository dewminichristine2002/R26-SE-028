# Dependencies (EAS will install fresh in the cloud)
node_modules/
**/node_modules/

# Build outputs
dist/
build/
web-build/
coverage/

# Android local build artifacts
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/.idea/
android/local.properties
android/captures/
android/app/release/
android/app/debug/

# iOS local build artifacts
ios/Pods/
ios/build/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/

# Expo + Metro caches
.expo/
.expo-shared/
.metro-cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / secrets (EAS reads from EAS env vars)
.env
.env.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# IDE / OS junk
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# Git
.git/
.gitignore.bak

# Misc large stuff that should never be uploaded
*.zip
*.tar.gz
*.apk
*.aab
*.ipa
