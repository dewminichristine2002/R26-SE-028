{
  "expo": {
    "name": "ElderMeds",
    "slug": "eldermeds",
    "scheme": "eldermeds",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-speech-recognition",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/medicine_reminder.mp3"
          ]
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.eldermeds.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "ElderMeds reads prescription photos to help check medicine safety.",
        "NSCameraUsageDescription": "ElderMeds can use the camera to capture a prescription for safety checking."
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "package": "com.eldermeds.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "ElderMeds reads prescription photos to help check medicine safety.",
          "cameraPermission": "ElderMeds can use the camera to capture a prescription for safety checking."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "sanuji",
    "extra": {
      "eas": {
        "projectId": "42883724-755a-47af-b465-a673a2dd9b0b"
      }
    }
  }
}
