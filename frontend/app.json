{
  "expo": {
    "name": "ElderMeds",
    "slug": "eldermeds",
    "scheme": "eldermeds",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.eldermeds.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "ElderMeds reads prescription photos to help check medicine safety.",
        "NSCameraUsageDescription": "ElderMeds can use the camera to capture a prescription for safety checking."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "package": "com.eldermeds.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "sandanima",
    "extra": {
      "eas": {
        "projectId": "a4f3c948-9552-4422-bfb1-981aa85e78c8"
      }
    }
  }
}
