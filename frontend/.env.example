# Physical Android / iPhone on same Wi‑Fi as laptop (run `ipconfig` / `ifconfig` for LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:5000/api
#
# If the phone cannot reach a LAN IP (mobile data only, or Expo tunnel), expose port 5000 with HTTPS, e.g.:
#   npx ngrok http 5000
# Then:
# EXPO_PUBLIC_API_URL=https://abcd-123.ngrok-free.app/api
#
EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_ENVIRONMENT=development

# For production:
# EXPO_PUBLIC_API_URL=https://api.eldermeds.com/api
# EXPO_PUBLIC_ENVIRONMENT=production
