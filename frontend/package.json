{
  "name": "eldermeds-frontend",
  "version": "1.0.0",
  "description": "ElderMeds Mobile App - React Native",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "node scripts/start-dev-client.js",
    "start:dev-client:tunnel": "expo start --dev-client --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest",
    "eas:build:dev": "eas build --platform android --profile development",
    "eas:build:dev:ios": "eas build --platform ios --profile development",
    "eas:build:preview": "eas build --platform all --profile preview",
    "eas:build:prod": "eas build --platform all --profile production",
    "eas:submit": "eas submit",
    "eas:update": "eas update"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.21.0",
    "axios": "^1.6.0",
    "expo": "^50.0.0",
    "expo-dev-client": "~3.3.12",
    "expo-image-picker": "~14.7.1",
    "expo-localization": "^14.0.0",
    "expo-speech": "~11.7.0",
    "i18next": "^23.7.0",
    "i18next-http-backend": "^2.4.0",
    "react": "^18.2.0",
    "react-i18next": "^13.5.0",
    "react-native": "0.73.6"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@types/react": "~18.2.45",
    "jest": "^29.7.0"
  }
}
