{
  "dataset": "medicine_safety_training_dataset.csv",
  "rows": 4075,
  "target": "risk_level",
  "risk_level_classes": [
    "Safe",
    "Warning",
    "Dangerous"
  ],
  "numeric_features": [
    "side_effect_count",
    "severe_side_effect_count",
    "side_effect_match_count",
    "interaction_count"
  ],
  "categorical_features": [
    "gender",
    "input_method",
    "max_interaction_severity",
    "has_medicine_allergy",
    "has_severe_reaction_log"
  ],
  "text_feature_name": "combined_text",
  "tuning": {
    "method": "RandomizedSearchCV",
    "cv_folds": 5,
    "n_iter": 30,
    "refit_metric": "f1_macro",
    "best_params": {
      "preprocessor__txt__tfidf__max_features": 300,
      "classifier__n_estimators": 800,
      "classifier__min_samples_split": 2,
      "classifier__min_samples_leaf": 1,
      "classifier__max_features": "sqrt",
      "classifier__max_depth": 32
    }
  }
}