{
  "name": "eldermeds-backend",
  "version": "1.0.0",
  "description": "ElderMeds Backend Server - Node.js Express",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "db:migrate": "node scripts/runMigrations.js up",
    "db:migrate:down": "node scripts/runMigrations.js down",
    "db:seed:allergy-demo": "node scripts/seedAllergyDemoData.js",
    "knowledge:build": "node scripts/buildMedicationKnowledge.js",
    "ml:drug-classes": "node ml/scripts/buildDrugClassDataset.js",
    "ml:export": "node ml/scripts/exportDataset.js",
    "ml:seed": "node ml/scripts/generateSeedDataset.js",
    "ml:public-dataset": "node ml/scripts/buildPublicTrainingDataset.js",
    "ml:prepare": "npm run ml:export && npm run ml:seed",
    "ml:prepare:public": "npm run ml:export && npm run ml:public-dataset",
    "ml:prepare:faers": "npm run ml:build-faers",
    "ml:setup": "node ml/scripts/runPython.js --setup",
    "ml:build-faers": "node ml/scripts/runPython.js build_faers_dataset.py",
    "ml:relabel-faers": "node ml/scripts/runPython.js relabel_faers_risk.py",
    "ml:compare": "node ml/scripts/runPython.js compare_models.py",
    "ml:train": "node ml/scripts/runPython.js train_production_model.py",
    "ml:train-rf": "node ml/scripts/runPython.js train_baseline.py",
    "ml:confusion-matrices": "node ml/scripts/runPython.js generate_confusion_matrices.py",
    "ml:hybrid-ablation": "node ml/scripts/runPython.js evaluate_hybrid_weights.py",
    "ml:retrain": "node ml/scripts/runPython.js retrain_pipeline.py",
    "ml:retrain:force": "node ml/scripts/runPython.js retrain_pipeline.py --force",
    "ml:retrain:local": "node ml/scripts/runPython.js retrain_pipeline.py --skip-export",
    "ml:evaluate": "node ml/scripts/runPython.js evaluate_system.py",
    "ml:thresholds": "node ml/scripts/runPython.js evaluate_thresholds.py",
    "ml:simulate-learning": "node ml/scripts/runPython.js simulate_continuous_learning.py",
    "ml:export-feedback": "node ml/scripts/exportFeedbackDataset.js",
    "ml:drift-monitor": "node ml/scripts/runPython.js drift_monitor.py",
    "ml:feedback-privacy": "node ml/scripts/runPython.js feedback_privacy.py",
    "ml:evaluate-all": "npm run ml:compare && npm run ml:hybrid-ablation && npm run ml:evaluate && npm run ml:thresholds && npm run ml:simulate-learning && npm run ml:drift-monitor"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "tesseract.js": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0"
  }
}
